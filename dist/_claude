_claude_plugin() {
  local curcontext="$curcontext" state line
  _arguments -C \
    '(-h --help)'{-h,--help}'[Display help for command]' \
    '1: :_claude_plugin_commands' \
    '*::arg:->args'
  case $state in
    args)
      case $line[1] in
        details) _claude_plugin_details ;;
        disable) _claude_plugin_disable ;;
        enable) _claude_plugin_enable ;;
        eval) _claude_plugin_eval ;;
        init|new) _claude_plugin_init ;;
        install|i) _claude_plugin_install ;;
        list) _claude_plugin_list ;;
        marketplace) _claude_plugin_marketplace ;;
        prune|autoremove) _claude_plugin_prune ;;
        tag) _claude_plugin_tag ;;
        uninstall|remove) _claude_plugin_uninstall ;;
        update) _claude_plugin_update ;;
        validate) _claude_plugin_validate ;;
      esac
      ;;
  esac
}

_claude_plugin_commands() {
  local -a _c=(
    'details:Show a plugins component inventory and projected token cost'
    'disable:Disable an enabled plugin'
    'enable:Enable a disabled plugin'
    'eval:Run eval cases (<eval dir>/**/case.yaml or prompt.md + graders/*.md; the eval dir is evals/ unless --eval-dir or the manifest says otherwise) against a plugin and report scored results. Target is a path, a plugin name, or a plugin@marketplace id — installed and skills-dir plugins both resolve (and add a no-plugin baseline arm)'
    'init:Scaffold a new plugin at ~/.claude/skills/<name>/ (auto-loads next session as <name>@skills-dir)'
    'install:Install a plugin from available marketplaces (use plugin@marketplace for specific marketplace)'
    'list:List installed plugins'
    'marketplace:Manage Claude Code marketplaces'
    'prune:Remove auto-installed dependencies that are no longer needed'
    'tag:Create a {name}--v{version} git tag for a plugin release, validating that plugin.json and any enclosing marketplace entry agree'
    'uninstall:Uninstall an installed plugin'
    'update:Update a plugin to the latest version (restart required to apply)'
    'validate:Validate a plugin or marketplace manifest, or the skills, agents, and commands in a directory'
    'help:Display help for command'
  )
  _describe -t commands 'plugin command' _c
}

_claude_plugin_details() {
  _arguments \
