_claude_plugin_eval() {
  local curcontext="$curcontext" state line
  _arguments -C \
    '(--ablation)--ablation[Run a no-plugin baseline arm and report the score delta (none | with-without; default: with-without whenever a plugin resolves — by name, or from the target path — and none when nothing does; under with-without, graders marked with-only, incl. tool_used: Skill, are a plugin-fired indicator rather than part of the score)]:mode:' \
    '*--allow-tools[Operator grant for gated tools (Bash, Write, Edit, WebFetch, mcp__*). Supports Tool(pattern:*) syntax]:tools:' \
    '(--case)--case[Filter cases by name glob]:glob:' \
    '(--eval-dir)--eval-dir[Directory name (below the plugin) that holds the eval cases; results go to <plugin>/<dir>/results/ — for an installed-plugin target, ./<dir>/results/ with this flag, else ./evals/results/ (default dir: the manifests experimental.evals value, else evals/)]:dir:_directories' \
    '(--json)--json[Print the full run result (prompts, graders, per-run scores) as JSON to stdout, or write it to this .json file]::path:_files' \
    '(--judge-model)--judge-model[Override LLM-grader model]:model:' \
    '(--keep-temp)--keep-temp[Preserve scaffold dirs for debugging]' \
    '(--max-cost-usd)--max-cost-usd[Optional hard cost ceiling; abort and report partial results if hit (exit 2). Overrun is bounded to one agent run — when that run breaches, paid graders (llm/baseline) are skipped while free graders still score it. Runs are already bounded by max_turns and timeout_seconds — only set this when you need a strict budget]:usd:' \
    '(--mocks)--mocks[Mock stand-ins for MCP servers, from <eval dir>/mocks/ (record | off; default: record — off spawns the real servers, gated by --allow-tools as usual)]:mode:' \
    '(--model)--model[Override model for all cases]:model:' \
    '(--no-publish)--no-publish[Keep the HTML report local only; skip publishing it to claude.ai]' \
    '(--no-scaffold)--no-scaffold[Explicitly skip scaffold_script]' \
    '(--output-dir)--output-dir[Directory for aggregate-result.json]:dir:_directories' \
    '(--publish-report)--publish-report[Also require publishing the report to claude.ai (already the default when your account supports it); explains why if unavailable]' \
    '(--report)--report[Write the self-contained HTML report (scores, prompts, grader verdicts) to <path> instead of the results dir]:path:_files' \
    '(--runs)--runs[Override per-case runs]:n:' \
    '(--scaffold)--scaffold[Run each cases scaffold_script (runs author-supplied bash as you; off by default — only use on case files you authored)]' \
    '*--tag[Filter cases by tag (repeatable)]:tag:' \
    '(--threshold)--threshold[Exit 1 if any case score is below this threshold]:0..1:' \
    '(--verbose)--verbose[Log per-message trace events to the debug log (use --debug-file to read them)]' \
    '(-h --help)'{-h,--help}'[Display help for command]' \
    '1: :_claude_plugin_eval_commands' \
    '*::arg:->args'
  case $state in
    args)
      case $line[1] in
        init) _claude_plugin_eval_init ;;
      esac
      ;;
  esac
}

